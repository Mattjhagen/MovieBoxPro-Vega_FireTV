<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="0.0dip" />
            <solid android:color="#ff4d4d4d" />
            <corners android:radius="3.0dip" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="0.0dip" />
                <gradient android:startColor="#ffdcdcdc" android:endColor="#ff919191" android:angle="0.0" />
                <corners android:radius="3.0dip" />
            </shape>
        </clip>
    </item>
</layer-list>